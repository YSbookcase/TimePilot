<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>TimePilot.WinForms</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\TimePilot.ico</ApplicationIcon>
    <Version>0.2.2</Version>
    <FileVersion>0.2.2.0</FileVersion>
    <AssemblyVersion>0.2.2.0</AssemblyVersion>
    <Product>ActiveLogbook</Product>
    <Description>A Windows desktop app for tracking and analyzing application usage time.</Description>
    <Authors>YSbookcase</Authors>
  </PropertyGroup>

  <ItemGroup>
    <None Update="Assets\TimePilot.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.7" />
  </ItemGroup>

</Project>
